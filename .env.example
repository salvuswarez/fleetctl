# Copy to .env and fill in. The real .env is gitignored.
# fleetctl reads this file from the directory above --config-dir (the repo
# root by default), so `!ref env:SMB_USER` in fleet.yml resolves.

SMB_HOST=nas.example.lan
SMB_SHARE=media
SMB_USER=fleetctl
SMB_PASS=change-me
SMB_BACKUP_DIR=firestick_backups
