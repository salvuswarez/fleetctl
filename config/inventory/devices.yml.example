# Written by `fleetctl scan`. Hand-edit tags/name/vars freely -- a scan
# updates only what it observed and never touches tags or vars.
devices:
  - id: living-room-stick
    type: firetv
    address: 192.168.1.50
    mac: aa:bb:cc:dd:ee:ff
    name: Living Room
    model: AFTKA
    os_version: "9"
    status: ok
    tags: [kodi]
    vars:
      kodi:
        # Reapplied after every deploy -- the shared build overwrites it.
        display:
          resolution_index: 18
          overscan: {left: 0, top: 0, right: 1920, bottom: 1080}
        # Per-device setting overrides, userdata-relative.
        settings:
          guisettings.xml:
            audiooutput.channels: "1"
