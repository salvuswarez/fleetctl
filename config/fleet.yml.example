# fleetctl fleet config. Copy to fleet.yml and fill in.
# Holds `!ref` pointers, never secret values -> safe to share.

artifacts:
  # SMB share, matching the predecessor's layout. Drop this block to keep
  # artifacts local under ~/.fleetctl/artifacts.
  smb:
    host: 192.168.1.50
    share: Kodi
    root: fleetctl
    user: !ref env:SMB_USER
    password: !ref env:SMB_PASS

# Fleet-wide SSH identity, used by every pack whose transport is SSH.
#
# A scan probes hosts that are not in the inventory yet, so there is no device
# record to read a credential from — without this an SSH probe has nothing to
# authenticate with. A device can override any of these under `vars.ssh`.
ssh:
  user: deck
  key_path: ~/.ssh/id_ed25519
  # Or a password instead of a key. Hold it as a reference, never a value.
  # password: !ref env:FLEETCTL_SSH_PASS
  #
  # Unknown host keys are rejected rather than trusted on first use, so a host
  # must be in this file before it can be reached.
  known_hosts: ~/.fleetctl/known_hosts

observability:
  # Relative paths resolve under ~/.fleetctl, not the working directory.
  audit_dir: audit

# Optional. Absent -> permissive, everything allowed.
policy:
  actors:
    "cli:*":
      allow: ["*"]
    "ha:*":
      allow: ["*"]
      confirm: [destructive]
    "mcp:*":
      allow: ["*"]
      confirm: [mutating, destructive]
      max_devices: 3

  # Devices named here are off-limits for the listed steps, regardless of actor.
  # protected:
  #   - match: {tags: [reference]}
  #     deny: ["kodi.deploy"]
  #     reason: Prove the change on a spare first.
