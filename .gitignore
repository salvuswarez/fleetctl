# --- Secrets and real device data -------------------------------------------
# fleetctl config holds `!ref` pointers, never values — but a user's own
# resolved config, inventory, and credentials must never be committed.
#
# Every directory rule below is anchored with a leading slash so it matches
# only at the repository root. An unanchored `config/` also matches
# `src/fleetctl/core/config/`, which silently excluded a whole source package.
.env
*.secret
# Contents, not the directory: git cannot re-include a file whose parent
# directory is excluded, so `/config/` would have hidden the examples too.
/config/**
!/config/**/
!/config/**/*.example

# ADB key material — a standing authorization token for every paired device.
.adb_keys/
*adbkey*

# --- Runtime state ----------------------------------------------------------
# Anchored for the same reason: `logs/`, `audit/` and `staging/` are all
# plausible package names.
/staging/
/logs/
/audit/
/forensics/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Claude Code ------------------------------------------------------------
# Local-only settings, scratch output, and working notes that may reference
# real device details pulled during a session. Tracked .claude/ content
# (skills, agents, commands, rules) is whitelisted below.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/rules/
!.claude/skills/
!.claude/settings.json
# .claude/memory/ is deliberately NOT whitelisted. It is a local curation
# surface an agent writes to unsupervised, so tracking it would put an
# unreviewed write target inside the commit surface. Durable knowledge earns
# its way into the repo by being written into a skill, rule, command, agent
# or CLAUDE.md — never by committing the memory file itself.

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.bak
